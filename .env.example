# Pick one provider: groq | gemini | ollama | openai | rules (offline regex baseline)
LLM_PROVIDER=groq
GROQ_API_KEY=
# GEMINI_API_KEY=
# LLM_MODEL=llama-3.3-70b-versatile
# PROMPT_VERSION=v2
RATE_LIMIT_PER_HOUR=20
# STATS_FILE=/tmp/stats.json
# Admin page (/admin): upload data, retrain, roll back. Leave empty to disable admin.
ADMIN_TOKEN=
# LLM_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3-flash-preview
